# Exclude sensitive files
.git/
api-keys.zsh
api-keys.sh

# nvim plugin lockfile - machine-specific, do not track
.config/nvim/lazy-lock.json

# Package manifests live in the repo for rebuilds; they are not dotfiles
# and must not be written into $HOME.
packages/

# Files destined for /etc, installed by system-setup.sh rather than by
# chezmoi. Anchored so it cannot swallow a real ~/.config/system path.
/system/

# Repo documentation. Anchored to the root so it does not also swallow
# .config/nvim/README.md, which IS a real dotfile.
/README.md
/MANUAL-STEPS.md
/system-setup.sh
