# If not running interactively, don't do anything (leave this at the top of this file)
[[ $- != *i* ]] && return

# Auto-launch zsh shell if in interactive bash
if command -v zsh &> /dev/null; then
  if [[ $(ps --no-header --pid=$PPID --format=comm) != "zsh" && -z ${BASH_EXECUTION_STRING} && ${SHLVL} == 1 ]]
  then
    shopt -q login_shell && LOGIN_OPTION='--login' || LOGIN_OPTION=''
    exec zsh $LOGIN_OPTION
  fi
fi

# Load the modular config via init.sh. Everything omarchy-zsh used to provide
# is now vendored under ~/.config/bash/ so this works on any distro.
# (The old boptions source line was dead — that file never existed.)
INIT="$HOME/.config/bash/init.sh"
[[ -r "$INIT" ]] && source "$INIT"

# Tool environments
[[ -r "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"
[[ -r "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi

# Must come AFTER `mise activate`: with go_set_gobin=false mise unsets GOBIN,
# so anything set earlier (e.g. in env/path.sh) gets wiped. Pinning it here
# keeps `go install` output out of mise's versioned toolchain dir, where every
# go upgrade would orphan it.
export GOBIN="$HOME/go/bin"

