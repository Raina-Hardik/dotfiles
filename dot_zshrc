# If not running interactively, don't do anything
[[ $- != *i* ]] && return

typeset -U PATH path

# Load the modular config via init.zsh. Everything omarchy-zsh used to provide
# is now vendored under ~/.config/zsh/ so this works on any distro.
INIT="$HOME/.config/zsh/init.zsh"
[[ -r "$INIT" ]] && source "$INIT"

# Tool environments
[[ -r "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"
[[ -r "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Must come AFTER `mise activate`: with go_set_gobin=false mise unsets GOBIN,
# so anything set earlier (e.g. in env/path.zsh) gets wiped. Pinning it here
# keeps `go install` output out of mise's versioned toolchain dir, where every
# go upgrade would orphan it.
export GOBIN="$HOME/go/bin"

# zsh-syntax-highlighting MUST be sourced last so it wraps every ZLE widget
# defined above it (notably the fzf widgets in functions/fzf-widgets.zsh).
# Anything added below this line will not be highlighted.
[[ -f /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && \
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

